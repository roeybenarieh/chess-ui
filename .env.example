# Copy this file to .env and fill in real values before running `docker compose up`.

# SQL Server 'sa' password used by both the db container and the server's connection string.
# Must satisfy SQL Server's complexity policy (8+ chars, upper+lower+digit or symbol).
DB_SA_PASSWORD=change_me_StrongP4ssword!

# Logical name to attach the seeded database under.
DB_NAME=ChessDB

# Gmail (or other SMTP) credentials used by the server to send verification/captcha emails.
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
