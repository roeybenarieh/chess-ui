# Copy this file to .env and fill in real values before running `docker compose up`.

# Postgres password used by the postgres container and the server's connection string.
DB_PASSWORD=change_me_StrongP4ssword!

# Database name and user (created by the postgres container on first start).
DB_NAME=chessdb
DB_USER=chess

# Gmail (or other SMTP) credentials used by the server to send verification/captcha emails.
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
